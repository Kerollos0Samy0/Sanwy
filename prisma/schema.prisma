generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Youth {
  id          String       @id @default(uuid())
  name        String
  grade       String?      
  dateOfBirth String?
  imageUrl    String?
  totalPoints Int          @default(0)
  createdAt   DateTime     @default(now())
  pointsLogs  PointsLog[]
}

model PointsLog {
  id          String       @id @default(uuid())
  youthId     String
  reason      String       
  points      Int          
  servantName String?      
  createdAt   DateTime     @default(now())

  youth       Youth        @relation(fields: [youthId], references: [id])
}
